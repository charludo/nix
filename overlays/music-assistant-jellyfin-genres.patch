 ITEM_KEY_RUNTIME_TICKS: Final = "RunTimeTicks"
 ITEM_KEY_USER_DATA: Final = "UserData"
+ITEM_KEY_GENRES: Final = "Genres"

 ITEM_TYPE_AUDIO: Final = "Audio"
 ITEM_TYPE_LIBRARY: Final = "CollectionFolder"
@@ -70,11 +71,13 @@
     ItemFields.Overview,
     ItemFields.ProviderIds,
     ItemFields.SortName,
+    ItemFields.Genres,
 ]
