+//! Streaming treble boost at 24 kHz: a high-shelf biquad (RBJ cookbook, Q 0.5,
+//! the same filter as ffmpeg's `highshelf`) followed by a soft limiter, so the
+//! boosted highs cannot clip. No lookahead, so no added latency. A gain of
+//! 0 dB bypasses all DSP.
+use anyhow::{Context, Result, ensure};
+
+const RATE: f64 = 24000.0;
+const Q: f64 = 0.5;
+/// Samples above this share of full scale are bent towards full scale.
+const KNEE: f64 = 0.9;
+
+pub fn parse(key: &str, value: Option<&str>, default: f64, range: std::ops::RangeInclusive<f64>) -> Result<f64> {
+    let Some(s) = value.filter(|v| !v.is_empty()) else {
+        return Ok(default);
+    };
+    let x: f64 = s
+        .parse()
+        .with_context(|| format!("{key}={s:?}: expected a number in {range:?}"))?;
+    ensure!(
+        x.is_finite() && range.contains(&x),
+        "{key}={s:?}: expected a number in {range:?}"
+    );
+    Ok(x)
+}
+
+pub struct Stream {
+    bypass: bool,
+    b: [f64; 3],
+    a: [f64; 2],
+    x: [f64; 2],
+    y: [f64; 2],
+    pub limited_samples: usize,
+}
+
+impl Stream {
+    pub fn new(gain_db: f64, frequency: f64) -> Self {
+        let a = 10f64.powf(gain_db / 40.0);
+        let w0 = 2.0 * std::f64::consts::PI * frequency / RATE;
+        let (sin, cos) = w0.sin_cos();
+        let alpha = sin / (2.0 * Q);
+        let beta = 2.0 * a.sqrt() * alpha;
+        let a0 = (a + 1.0) - (a - 1.0) * cos + beta;
+        Self {
+            bypass: gain_db == 0.0,
+            b: [
+                a * ((a + 1.0) + (a - 1.0) * cos + beta) / a0,
+                -2.0 * a * ((a - 1.0) + (a + 1.0) * cos) / a0,
+                a * ((a + 1.0) + (a - 1.0) * cos - beta) / a0,
+            ],
+            a: [
+                2.0 * ((a - 1.0) - (a + 1.0) * cos) / a0,
+                ((a + 1.0) - (a - 1.0) * cos - beta) / a0,
+            ],
+            x: [0.0; 2],
+            y: [0.0; 2],
+            limited_samples: 0,
+        }
+    }
+
+    pub fn push(&mut self, bytes: Vec<u8>, sink: &mut dyn FnMut(Vec<u8>) -> Result<()>) -> Result<()> {
+        if self.bypass {
+            return sink(bytes);
+        }
+        ensure!(bytes.len() % 2 == 0, "invalid PCM for treble processing");
+        let mut out = Vec::with_capacity(bytes.len());
+        for b in bytes.chunks_exact(2) {
+            let x = i16::from_le_bytes([b[0], b[1]]) as f64 / 32768.0;
+            let y = self.b[0] * x + self.b[1] * self.x[0] + self.b[2] * self.x[1]
+                - self.a[0] * self.y[0]
+                - self.a[1] * self.y[1];
+            self.x = [x, self.x[0]];
+            self.y = [y, self.y[0]];
+            let m = y.abs();
+            let limited = if m > KNEE {
+                self.limited_samples += 1;
+                y.signum() * (KNEE + (1.0 - KNEE) * ((m - KNEE) / (1.0 - KNEE)).tanh())
+            } else {
+                y
+            };
+            let sample = (limited * 32768.0).round().clamp(i16::MIN as f64, i16::MAX as f64) as i16;
+            out.extend_from_slice(&sample.to_le_bytes());
+        }
+        sink(out)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn run(gain: f64, input: &[i16]) -> Vec<i16> {
+        let mut s = Stream::new(gain, 3000.0);
+        let mut out = Vec::new();
+        for chunk in input.chunks(1920) {
+            s.push(chunk.iter().flat_map(|x| x.to_le_bytes()).collect(), &mut |b| {
+                out.extend(b.chunks_exact(2).map(|b| i16::from_le_bytes([b[0], b[1]])));
+                Ok(())
+            })
+            .unwrap();
+        }
+        out
+    }
+
+    fn sine(freq: f64, amp: f64) -> Vec<i16> {
+        (0..24000)
+            .map(|i| (amp * (2.0 * std::f64::consts::PI * freq * i as f64 / RATE).sin()) as i16)
+            .collect()
+    }
+
+    fn peak(x: &[i16]) -> f64 {
+        x[12000..].iter().map(|v| (*v as f64).abs()).fold(0.0, f64::max)
+    }
+
+    #[test]
+    fn zero_gain_is_identity() {
+        let x = sine(5000.0, 20000.0);
+        assert_eq!(run(0.0, &x), x);
+    }
+
+    #[test]
+    fn boosts_highs_keeps_lows() {
+        let low = sine(200.0, 4000.0);
+        let high = sine(8000.0, 4000.0);
+        assert!((peak(&run(6.0, &low)) / peak(&low) - 1.0).abs() < 0.03);
+        assert!((peak(&run(6.0, &high)) / peak(&high) - 2.0).abs() < 0.1);
+    }
+
+    #[test]
+    fn limits_instead_of_wrapping() {
+        // Boosted to twice full scale: bent into range, never wrapped around.
+        let out = run(6.0, &sine(8000.0, 30000.0));
+        assert!(peak(&out) > 31000.0);
+        let x = sine(8000.0, 15000.0);
+        let reference = run(6.0, &x);
+        assert!(out[12000..]
+            .iter()
+            .zip(&reference[12000..])
+            .all(|(o, r)| (*o as i32) * (*r as i32) >= 0));
+    }
+}
