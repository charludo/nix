diff -ruN a/linux_voice_assistant/wake_word_scores.py b/linux_voice_assistant/wake_word_scores.py
--- a/linux_voice_assistant/wake_word_scores.py	1970-01-01 01:00:00.000000000 +0100
+++ b/linux_voice_assistant/wake_word_scores.py	2026-11-01 15:55:17.743852195 +0100
@@ -0,0 +1,58 @@
+"""Peaks of the wake word scores, for collecting near misses.
+
+A peak starts when a wake word's score rises to the floor and ends when it
+falls below again (or after ``MAX_PEAK_SECONDS``). Each peak is reported once,
+when it is over, with its highest score - whether or not that crossed the
+detection threshold.
+"""
+
+import time
+from typing import Any, Callable, Dict, Optional
+
+MAX_PEAK_SECONDS = 3.0
+
+
+class _Peak:
+    def __init__(self, now: float, score: float, threshold: float) -> None:
+        self.start = now
+        self.at = now
+        self.score = score
+        self.threshold = threshold
+
+
+class WakeWordScores:
+    def __init__(self, floor: float, report: Callable[[Dict[str, Any]], None]) -> None:
+        self.floor = floor
+        self.report = report
+        self._peaks: Dict[str, _Peak] = {}
+
+    def update(self, wake_word: Any, score: float, threshold: float, now: Optional[float] = None) -> None:
+        """Feed one fresh score (not a filler between strides)."""
+        now = time.monotonic() if now is None else now
+        key = getattr(wake_word, "id", None) or wake_word.wake_word
+        peak = self._peaks.get(key)
+
+        if peak is not None and (score < self.floor or now - peak.start > MAX_PEAK_SECONDS):
+            del self._peaks[key]
+            self._report(wake_word, key, peak, now)
+            peak = None
+
+        if score < self.floor:
+            return
+        if peak is None:
+            self._peaks[key] = _Peak(now, score, threshold)
+        elif score > peak.score:
+            peak.score, peak.at, peak.threshold = score, now, threshold
+
+    def _report(self, wake_word: Any, key: str, peak: _Peak, now: float) -> None:
+        self.report(
+            {
+                "id": key,
+                "wake_word": wake_word.wake_word,
+                "score": round(peak.score, 3),
+                "threshold": round(peak.threshold, 3),
+                "duration_s": round(now - peak.start, 2),
+                # The peak's highest score was this long before the report.
+                "ago_s": round(now - peak.at, 2),
+            }
+        )
