+"""End-of-speech detection on the incoming audio, ahead of the client.
+
+Home Assistant streams audio to the STT server while it waits for its own VAD
+to declare the end of speech, and returns as soon as the server sends a
+transcript, even mid-stream. This decides the end of speech here, earlier:
+
+- Silero VAD (32 ms frames) tracks speech and silence;
+- after a short silence, Pipecat's Smart Turn model judges from the audio so
+  far (intonation) whether the speaker has finished; if so, the turn ends;
+- after a longer silence, it ends regardless.
+
+The client's own VAD stays in charge whenever it is faster (e.g. noise that
+Silero keeps calling speech).
+"""
+from __future__ import annotations
+
+import asyncio
+import logging
+from dataclasses import dataclass, field
+from typing import Callable, Optional
+
+import numpy as np
+import onnxruntime
+from pysilero_vad import SileroVoiceActivityDetector
+
+_LOGGER = logging.getLogger(__name__)
+
+RATE = 16000
+_SILERO_BYTES = SileroVoiceActivityDetector.chunk_bytes()
+_SILERO_SECONDS = SileroVoiceActivityDetector.chunk_samples() / RATE
+
+
+def _slaney_mel_filters(n_fft: int = 400, n_mels: int = 80, sr: int = RATE) -> np.ndarray:
+    """Whisper's mel filter bank (Slaney scale and norm), shape (n_mels, n_fft//2+1)."""
+
+    def hz_to_mel(f):
+        f = np.asarray(f, dtype=np.float64)
+        mel = 3.0 * f / 200.0
+        log = f >= 1000.0
+        mel = np.where(log, 15.0 + np.log(np.maximum(f, 1e-10) / 1000.0) * 27.0 / np.log(6.4), mel)
+        return mel
+
+    def mel_to_hz(m):
+        m = np.asarray(m, dtype=np.float64)
+        f = 200.0 * m / 3.0
+        log = m >= 15.0
+        return np.where(log, 1000.0 * np.exp(np.log(6.4) / 27.0 * (m - 15.0)), f)
+
+    fft_freqs = np.linspace(0, sr / 2, n_fft // 2 + 1)
+    mel_pts = mel_to_hz(np.linspace(hz_to_mel(0.0), hz_to_mel(sr / 2), n_mels + 2))
+    diff = np.diff(mel_pts)
+    slopes = mel_pts[None, :] - fft_freqs[:, None]
+    down = -slopes[:, :-2] / diff[:-1]
+    up = slopes[:, 2:] / diff[1:]
+    fb = np.maximum(0.0, np.minimum(down, up))  # (n_freqs, n_mels)
+    fb *= (2.0 / (mel_pts[2 : n_mels + 2] - mel_pts[:n_mels]))[None, :]
+    return fb.T
+
+
+class SmartTurn:
+    """Pipecat Smart Turn v3: probability that the speaker has finished."""
+
+    SECONDS = 8
+    N_FFT = 400
+    HOP = 160
+
+    def __init__(self, model_path: str, threads: int = 4) -> None:
+        # One call per pause, nothing else on the CPU meanwhile (STT runs on
+        # the NPU): 4 threads take 26 ms per call on SRV-VOICE, 1 takes 82 ms.
+        opts = onnxruntime.SessionOptions()
+        opts.execution_mode = onnxruntime.ExecutionMode.ORT_SEQUENTIAL
+        opts.inter_op_num_threads = 1
+        opts.intra_op_num_threads = threads
+        opts.graph_optimization_level = onnxruntime.GraphOptimizationLevel.ORT_ENABLE_ALL
+        self._session = onnxruntime.InferenceSession(
+            model_path, sess_options=opts, providers=["CPUExecutionProvider"]
+        )
+        self._mel = _slaney_mel_filters(self.N_FFT)
+        n = np.arange(self.N_FFT)
+        self._window = 0.5 - 0.5 * np.cos(2 * np.pi * n / self.N_FFT)  # periodic Hann
+
+    def features(self, pcm16: bytes) -> np.ndarray:
+        """Whisper log-mel features of the last 8 s, as WhisperFeatureExtractor
+        (chunk_length=8, do_normalize=True) computes them. float64: in float32
+        the score moves by up to 0.48 at some cuts (2 of 300 verdicts flip)."""
+        n = self.SECONDS * RATE
+        audio = np.frombuffer(pcm16, dtype=np.int16).astype(np.float64) / 32768.0
+        audio = audio[-n:]
+        audio = np.pad(audio, (n - len(audio), 0))
+        audio = (audio - audio.mean()) / np.sqrt(audio.var() + 1e-7)
+        padded = np.pad(audio, self.N_FFT // 2, mode="reflect")
+        frames = 1 + (len(padded) - self.N_FFT) // self.HOP
+        idx = np.arange(self.N_FFT)[None, :] + self.HOP * np.arange(frames)[:, None]
+        spec = np.abs(np.fft.rfft(padded[idx] * self._window, axis=1)) ** 2
+        log_spec = np.log10(np.maximum(spec @ self._mel.T, 1e-10)).T[:, :-1]
+        log_spec = np.maximum(log_spec, log_spec.max() - 8.0)
+        return ((log_spec + 4.0) / 4.0).astype(np.float32)[None]
+
+    def __call__(self, pcm16: bytes) -> float:
+        out = self._session.run(None, {"input_features": self.features(pcm16)})
+        return float(np.asarray(out[0]).reshape(-1)[0])
+
+
+@dataclass
+class EndpointingConfig:
+    smart_turn: SmartTurn
+    speech_threshold: float = 0.5  # Silero: speech above, silence at or below
+    start_threshold: float = 0.3  # Silero, before the command has started
+    start_seconds: float = 0.3  # speech needed before the command counts as started
+    min_command_seconds: float = 1.0  # never end earlier than this
+    ask_after_silence: float = 0.064  # ask Smart Turn after this much silence
+    turn_threshold: float = 0.7  # Smart Turn: finished above this
+    end_after_silence: float = 0.6  # end regardless after this much silence
+    pad_end: float = 0.0  # silence appended before transcribing a cut here
+    # Start transcribing after this much silence (None: when Smart Turn is
+    # asked). Earlier means the transcript is ready by the verdict, but it
+    # covers the audio only up to that point.
+    speculate_after_silence: Optional[float] = None
+
+
+@dataclass
+class Endpointer:
+    """Decides the end of one voice command from its audio, fed as it arrives."""
+
+    config: EndpointingConfig
+    vad: SileroVoiceActivityDetector = field(default_factory=SileroVoiceActivityDetector)
+    audio: bytearray = field(default_factory=bytearray)
+    _pending: bytearray = field(default_factory=bytearray)
+    _started: bool = False
+    _speech: float = 0.0
+    _silence: float = 0.0
+    _asked: bool = False
+    seconds: float = 0.0
+    reason: Optional[str] = None
+    turn_probabilities: list = field(default_factory=list)
+    # Called once per pause with the audio so far (at speculate_after_silence,
+    # or right before Smart Turn is asked), so the caller can transcribe it
+    # meanwhile (the NPU is idle while Smart Turn runs on the CPU). If the
+    # turn ends in that pause, that audio is the command: `speculated` is its
+    # length in bytes (None once speech resumes).
+    on_speculate: Optional[Callable[[bytes], None]] = None
+    speculated: Optional[int] = None
+
+    def _speculate(self) -> bytes:
+        audio = bytes(self.audio)
+        if self.on_speculate and self.speculated is None:
+            self.speculated = len(audio)
+            self.on_speculate(audio)
+        return audio
+
+    async def feed(self, chunk: bytes) -> bool:
+        """Add audio; True once the speaker is done."""
+        if self.reason:
+            return True
+        self.audio += chunk
+        self._pending += chunk
+        cfg = self.config
+        while len(self._pending) >= _SILERO_BYTES:
+            frame = bytes(self._pending[:_SILERO_BYTES])
+            del self._pending[:_SILERO_BYTES]
+            p = self.vad(frame)
+            self.seconds += _SILERO_SECONDS
+            if not self._started:
+                self._speech = self._speech + _SILERO_SECONDS if p > cfg.start_threshold else 0.0
+                self._started = self._speech >= cfg.start_seconds
+                continue
+            if p > cfg.speech_threshold:
+                self._silence = 0.0
+                self._asked = False
+                self.speculated = None
+                continue
+            self._silence += _SILERO_SECONDS
+            if self.seconds < cfg.min_command_seconds:
+                continue
+            spec = cfg.speculate_after_silence
+            if spec is not None and self._silence >= spec:
+                self._speculate()
+            if self._silence >= cfg.ask_after_silence and not self._asked:
+                self._asked = True
+                # Smart Turn judges the audio up to now either way.
+                audio = self._speculate()
+                prob = await asyncio.to_thread(cfg.smart_turn, audio)
+                self.turn_probabilities.append(round(prob, 3))
+                if prob > cfg.turn_threshold:
+                    self.reason = "turn"
+                    return True
+            if self._silence >= cfg.end_after_silence:
+                self.reason = "silence"
+                return True
+        return False
