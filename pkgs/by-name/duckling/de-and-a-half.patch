+-- "anderthalb Stunden", "zweieinhalb Minuten"
+ruleFusedAndAHalf :: Rule
+ruleFusedAndAHalf = Rule
+  { name = "<integer>einhalb <unit-of-duration>"
+  , pattern =
+    [ regex "anderthalb|(ein|zwei|drei|vier|f(?:ü|ue)nf|sechs|sieben|acht|neun|zehn|elf|zw(?:ö|oe)lf)einhalb"
+    , dimension TimeGrain
+    ]
+  , prod = \case
+      (Token RegexMatch (GroupMatch (n:_)):Token TimeGrain grain:_) -> do
+        -- "anderthalb" leaves the group empty
+        v <- if Text.null n then Just 1 else lookup (Text.toLower n) fused
+        Token Duration <$> nPlusOneHalf grain v
+      _ -> Nothing
+  }
+  where
+  fused :: [(Text.Text, Int)]
+  fused =
+    [ ("ein", 1), ("zwei", 2), ("drei", 3), ("vier", 4), ("fünf", 5)
+    , ("fuenf", 5), ("sechs", 6), ("sieben", 7), ("acht", 8), ("neun", 9)
+    , ("zehn", 10), ("elf", 11), ("zwölf", 12), ("zwoelf", 12)
+    ]
+
+-- "zwei Stunden und eine halbe"
+ruleAndAHalfAfter :: Rule
+ruleAndAHalfAfter = Rule
+  { name = "<integer> <unit-of-duration> and a half"
+  , pattern =
+    [ Predicate isNatural
+    , dimension TimeGrain
+    , regex "und (eine )?halbe?"
+    ]
+  , prod = \case
+      (Token Numeral NumeralData{TNumeral.value = v}:Token TimeGrain grain:_) ->
+        Token Duration <$> nPlusOneHalf grain (floor v)
+      _ -> Nothing
+  }
+
